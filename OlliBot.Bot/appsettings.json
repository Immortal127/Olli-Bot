{
  "OwnerID": 119904333750861824,
  "BotID": 1118358168708329543,
  "MainServer": 529624471351590922,
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Expressions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:dd-MM-yyyy HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "theme": "Serilog.Sinks.Console.LogThemes.LogThemes::Code, Serilog.Sinks.Console.LogThemes",
          "useUtcTimestamp": true
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs\\log-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:dd-MM-yyyy HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "useUtcTimestamp": true
        }
      }
    ]
    /* Example filter (uncomment if you want to suppress specific messages)
    ,"Filter": [
      {
        "Name": "ByExcluding",
        "Args": { "expression": "@Message like '%Unknown event:%'" }
      }
    ]
    */
  }
}
