{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=TestDatabase.db"
  },
  "Scheduling": {
    "HumbleBundleUpdate": {
      "Cron": "0 0 23 * * ?",
      "TimeZone": "Europe/London"
    },
    "EmoteRankingUpdate": {
      "Cron": "0 0 23 * * ?",
      "TimeZone": "Europe/London"
    },
    "EmoteRankingClear": {
      "Cron": "0 0 23 * * ?",
      "TimeZone": "Europe/London"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:dd-MM-yyyy HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "theme": "Serilog.Sinks.Console.LogThemes.LogThemes::Code, Serilog.Sinks.Console.LogThemes",
          "useUtcTimestamp": true
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs\\log-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:dd-MM-yyyy HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "useUtcTimestamp": true
        }
      }
    ]
    /* Example filter (uncomment if we want to suppress specific messages)
    ,"Filter": [
      {
        "Name": "ByExcluding",
        "Args": { "expression": "@Message like '%Unknown event:%'" }
      }
    ]
    */
  }
}
